    "build": "next build",
    "prestart": "node scripts/copy-pdf-worker.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/csv.test.ts tests/file-info.test.ts tests/image-processing.test.ts tests/hash.test.ts tests/xml.test.ts tests/pdf-inspector.test.ts tests/pdf-text-to-pdf.test.ts tests/markdown.test.ts tests/markdown-to-html.test.ts tests/html-to-markdown.test.ts tests/markdown-to-pdf.test.ts tests/markdown-to-docx.test.ts tests/markdown-table.test.ts tests/table-to-markdown.test.ts tests/markdown-toc.test.ts tests/markdown-formatter.test.ts tests/web-url.test.ts tests/theme.test.ts",
    "test:xml-browser": "node scripts/qa-xml.mjs",
    "test:web-url-browser": "node scripts/qa-web-url.mjs",
    "test:pdf-browser": "node scripts/qa-pdf-inspector.mjs",
    "test:text-pdf-browser": "node scripts/qa-text-to-pdf.mjs",
    "test:markdown-browser": "node scripts/qa-markdown.mjs",
    "test:markdown-html-browser": "node scripts/qa-markdown-to-html.mjs",
    "test:html-markdown-browser": "node scripts/qa-html-to-markdown.mjs",
    "test:markdown-pdf-browser": "node scripts/qa-markdown-to-pdf.mjs",
    "test:markdown-docx-browser": "node scripts/qa-markdown-to-docx.mjs",
    "test:markdown-table-browser": "node scripts/qa-markdown-table.mjs",
    "test:table-markdown-browser": "node scripts/qa-table-to-markdown.mjs",
    "test:markdown-toc-browser": "node scripts/qa-markdown-toc.mjs",
    "test:markdown-formatter-browser": "node scripts/qa-markdown-formatter.mjs"
  },
  "dependencies": {
    "docx": "^9.13.0",
    "dompurify": "^3.4.17",
    "next": "^16.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5"
