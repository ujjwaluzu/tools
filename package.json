    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "jszip": "^3.10.2",
    "patchright": "^1.64.1",
    "typescript": "^5.9.0"
  }
